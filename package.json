{
  "name": "cast-local",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "description": "Peer-to-peer (P2P) local network file transfer tool using WebSockets and WebRTC data channels.",
  "license": "ISC",
  "scripts": {
    "dev": "nx run-many -t serve,dev --projects=server,client --parallel=2",
    "build": "nx run client:build",
    "start": "nx run server:start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "release": "nx release",
    "release:dry": "nx release --dry-run",
    "clean": "rm -rf .astro dist node_modules pnpm-lock.yaml client/dist client/node_modules server/node_modules shared/node_modules",
    "phoenix": "pnpm run clean && pnpm install"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@maxigarcia/eslint-config": "^1.14.1",
    "@nx/js": "^22.0.0",
    "eslint": "^10.12.0",
    "nx": "^22.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  }
}
