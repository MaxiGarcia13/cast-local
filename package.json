{
  "name": "roomcast",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "description": "Peer-to-peer (P2P) local network file transfer tool using WebSockets and WebRTC data channels.",
  "license": "ISC",
  "scripts": {
    "dev:client": "nx run client:dev",
    "dev:server": "nx run server:dev",
    "build": "nx run-many -t build",
    "start": "nx run server:start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "release": "nx release",
    "release:dry": "nx release --dry-run",
    "clean": "nx run-many -t clean && rm -rf node_modules pnpm-lock.yaml .nx dist",
    "phoenix": "pnpm run clean && pnpm install"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@maxigarcia/eslint-config": "^1.14.1",
    "@nx/js": "^22.0.0",
    "eslint": "^10.12.0",
    "nx": "^22.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  }
}
