{
  "name": "cast-local",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@12.11.2",
  "description": "Peer-to-peer (P2P) local network file transfer tool using WebSockets and WebRTC data channels.",
  "author": "",
  "license": "ISC",
  "keywords": [],
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n astro,signal -c cyan,magenta \"astro dev --host\" \"pnpm dev:server\"",
    "dev:server": "tsx server/index.ts",
    "dev:web": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf .astro dist node_modules pnpm-lock.yaml",
    "phoenix": "pnpm run clean && pnpm install"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@astrojs/vue": "^7.0.3",
    "@nanostores/vue": "^1.1.0",
    "astro": "^7.3.8",
    "nanostores": "^1.5.5",
    "qrcode": "^1.5.4",
    "vue": "^3.5.43",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@astrojs/node": "^11.1.7",
    "@maxigarcia/eslint-config": "^1.14.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.1.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15"
  }
}
